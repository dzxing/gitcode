{
  "appId": "dev.gitcode.workbench",
  "productName": "GitCode",
  "electronVersion": "45.0.0",
  "asar": true,
  "asarUnpack": ["electron/*.cjs", "electron/*.json", "electron/vendor/**/*"],
  "npmRebuild": false,
  "directories": {
    "output": "../../release/desktop/${version}",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "electron/*.cjs",
    "electron/*.json",
    "electron/vendor/**/*",
    "assets/**/*",
    "third-party/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": ".gitcode-local/wsl-runtime/${arch}",
        "to": "wsl",
        "filter": ["**/*"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "include": "scripts/installer.nsh"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/icon.icns",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/icon.png",
    "category": "Development",
    "maintainer": "GitCode contributors"
  },
  "beforePack": "scripts/prepare-wsl-runtime.cjs"
}
