{
  "name": "@gitcode/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 43189",
    "build": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1 --port 43189",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format": "prettier --write app content nuxt.config.ts tsconfig.json package.json README.md",
    "format:check": "prettier --check app content nuxt.config.ts tsconfig.json package.json README.md",
    "typecheck": "nuxt prepare && nuxt typecheck",
    "lint": "eslint app nuxt.config.ts eslint.config.js --max-warnings 0",
    "lint:fix": "bun run lint --fix"
  },
  "dependencies": {
    "@gitcode/brand": "workspace:*",
    "marked": "17.0.0",
    "nuxt": "4.6.4",
    "vue": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "@vue/server-renderer": "catalog:",
    "prettier": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:"
  }
}
