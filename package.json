{
  "name": "gitcode-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": {
    "packages": [
      "apps/desktop",
      "packages/*"
    ],
    "catalog": {
      "vue": "3.5.44",
      "@vue/server-renderer": "3.5.44",
      "typescript": "5.9.3",
      "vue-tsc": "3.3.8",
      "@resvg/resvg-js": "2.6.2",
      "prettier": "3.9.10",
      "eslint": "9.39.5",
      "@eslint/js": "9.39.5",
      "globals": "17.13.0",
      "typescript-eslint": "8.72.1",
      "eslint-plugin-vue": "10.12.0",
      "vue-eslint-parser": "10.4.1"
    }
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "secrets:install": "node scripts/check-secrets.mjs install",
    "check:secrets": "node scripts/check-secrets.mjs history",
    "check:secrets:staged": "node scripts/check-secrets.mjs staged",
    "test:secrets": "node --test scripts/tests/secrets-policy.test.mjs",
    "dev": "bun run --cwd apps/desktop dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "preview": "bun run --cwd apps/desktop preview",
    "start": "bun run --cwd apps/desktop desktop",
    "desktop": "bun run --cwd apps/desktop desktop",
    "desktop:wsl": "bun run --cwd apps/desktop desktop:wsl",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "desktop:build:win": "bun run --cwd apps/desktop desktop:build:win",
    "test": "bun run --cwd apps/desktop test",
    "test:ui": "bun run --cwd apps/desktop test:ui",
    "test:wsl": "bun run --cwd apps/desktop test:wsl",
    "test:core-reload": "bun run --cwd apps/desktop test:core-reload",
    "test:icons": "bun run --cwd apps/desktop test:icons",
    "icons:generate": "bun run --cwd apps/desktop icons:generate",
    "fonts:install": "bun run --cwd apps/desktop fonts:install",
    "typecheck": "bun run typecheck:desktop",
    "lint": "bun run lint:shared && bun run lint:desktop",
    "lint:fix": "bun run lint:shared --fix && bun run --cwd apps/desktop lint:fix",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:public-history": "node scripts/check-public-history.mjs",
    "check": "bun run check:boundaries && bun run lint:shared && bun run --cwd apps/desktop check && bun run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:desktop": "bun run --cwd apps/desktop desktop:build",
    "typecheck:desktop": "bun run --cwd apps/desktop typecheck",
    "lint:shared": "eslint eslint.config.js scripts packages/brand/scripts --max-warnings 0",
    "lint:desktop": "bun run --cwd apps/desktop lint"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "globals": "catalog:"
  },
  "trustedDependencies": [
    "electron",
    "node-pty",
    "esbuild"
  ],
  "overrides": {
    "nanoid": "3.3.20",
    "source-map-js": "1.2.4"
  }
}
