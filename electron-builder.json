{
  "appId": "dev.gitcode.workbench",
  "productName": "GitCode",
  "electronVersion": "45.0.0",
  "asar": true,
  "asarUnpack": ["electron/rebase-editor.cjs"],
  "npmRebuild": false,
  "directories": {
    "output": "release/${version}",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "electron/*.cjs",
    "electron/*.json",
    "assets/**/*",
    "third-party/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": ".gitcode-local/bundled-git/${arch}",
        "to": "git",
        "filter": ["**/*"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/icon.icns",
    "category": "public.app-category.developer-tools"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "assets/icon.png",
    "category": "Development",
    "maintainer": "GitCode contributors"
  },
  "beforePack": "scripts/prepare-windows-git.cjs"
}
